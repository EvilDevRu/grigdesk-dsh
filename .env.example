# Ключи режимов Z.ai для живого smoke допуска GLM (`grigdesk-dsh-ctl admit`).
# Файл читается самим smoke; в CI не используется — допуск это вход сборки.
# Обычный API
ZAI_API_KEY=
# Coding Plan
ZAI_CODING_API_KEY=
# Режим потребителя по умолчанию для подсказок CLI (сам admit требует явный --mode)
GRIGDESK_GLM_API_MODE=api
