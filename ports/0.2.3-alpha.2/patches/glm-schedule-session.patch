+        .map(task => ({ task, at: Math.max(Date.parse(task.record.scheduledAt), this.nextAdmissionAt(task)) }))
+        .sort((a, b) => a.at - b.at)
+      const first = candidates[0]
+      const now = Date.now()
+      if (!dispatch || !first || first.at > now || this.stopping || agent.status !== 'idle') {
+        return { nextAt: first?.at ?? null, dispatched: false }
+      }
+
+      const { task } = first
+      const occurrence = isRecurringScheduleRecord(task.record)
+        ? resolveRecurringOccurrence(task.record, now) : { occurrenceAt: task.record.scheduledAt }
+      const text = renderReminderFraming({ ...task.record, scheduledAt: occurrence.occurrenceAt })
+      const message = createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'schedule' } })
+      await this.commit(this.advanced(task, occurrence, {
+        scheduledAt: occurrence.occurrenceAt, deliveredAt: new Date(now).toISOString(),
+        messageId: message.id, targetSessionId: sessionId,
+      }))
+
+      signal?.throwIfAborted()
+      if (this.stopping) throw new Error('Доставка расписания остановлена')
+      agent.followup(message)
+      return { nextAt: null, dispatched: true }
+    }))
